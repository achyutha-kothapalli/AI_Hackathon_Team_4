# Copy to .env (local) or set in Vercel → Project → Settings → Environment Variables.

# Required for real analysis. Without it the API runs in mock mode.
ANTHROPIC_API_KEY=

# claude | trustedtokens | mock  (defaults to whichever provider has a key, else mock)
ANALYZER=

# Model and reasoning effort (low | medium | high). Lower effort = faster, cheaper.
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# Domain pack used when the client sends none (see backend/app/domains/).
DEFAULT_PROFILE=german_letter

MAX_PAGES=6
# Comma-separated frontend URLs allowed to call the API (add your Vercel frontend URL).
CORS_ORIGINS=http://localhost:5173

# --- TrustedTokens (EU-hosted open models, https://trustedtokens.eu) ---
# Set ANALYZER=trustedtokens (or leave ANTHROPIC_API_KEY empty) to use it.
TRUSTEDTOKENS_API_KEY=
# A vision-capable model id from GET https://api.trustedtokens.eu/v1/models
TRUSTEDTOKENS_MODEL=Qwen/Qwen3.8-27B
TRUSTEDTOKENS_BASE_URL=https://api.trustedtokens.eu/v1
