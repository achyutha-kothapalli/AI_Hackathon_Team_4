{
  "$comment": "Rules for German official letters. 'applies_to' is an ontology class id; a rule applies to that class and all its descendants (official_letter = every letter). Rule types are implemented in app/harness/rules.py. Patterns are Python regular expressions matched case-insensitively against the letter text.",
  "version": "1.0",
  "rules": [
    {
      "id": "C-OBJECTION-DEADLINE",
      "type": "requires_item",
      "applies_to": "administrative_decision",
      "item_kind": "deadline",
      "match_any": [
        "einspruch",
        "widerspruch",
        "klage",
        "rechtsbehelf",
        "objection",
        "appeal"
      ],
      "severity": "warning",
      "message": "Official decisions normally state how long you have to object, but no objection deadline was extracted. Check the 'Rechtsbehelfsbelehrung' section of the letter."
    },
    {
      "id": "C-MAHNBESCHEID-OBJECTION",
      "type": "requires_item",
      "applies_to": "mahnbescheid",
      "item_kind": "deadline",
      "match_any": [
        "widerspruch",
        "objection"
      ],
      "severity": "warning",
      "legal_basis": "zpo_692",
      "message": "A court payment order allows an objection, but no objection deadline was extracted. Check the letter carefully."
    },
    {
      "id": "C-PAYMENT-AMOUNT",
      "type": "requires_item",
      "applies_to": "payment_demand",
      "item_kind": "payment",
      "match_any": [],
      "severity": "warning",
      "message": "This looks like a payment demand, but no amount to pay was extracted."
    },
    {
      "id": "C-PAYMENT-REFERENCE",
      "type": "requires_item",
      "applies_to": "payment_demand",
      "item_kind": "reference",
      "match_any": [],
      "severity": "warning",
      "message": "No reference number (Kassenzeichen, Aktenzeichen, Kundennummer) was extracted. Payments without the correct reference may not be matched."
    },
    {
      "id": "C-MISSED-DEADLINE-DATE",
      "type": "signal_coverage",
      "applies_to": "official_letter",
      "item_kind": "deadline",
      "pattern": "(?:bis(?: zum| spätestens)?|spätestens(?: am| bis)?|frist(?:ende)?:?|fällig am)\\s+(?P<fact>\\d{1,2}\\.\\s?\\d{1,2}\\.\\s?\\d{2,4})",
      "severity": "warning",
      "message": "The letter mentions a deadline ({fact}) that is not listed among the important details."
    },
    {
      "id": "C-MISSED-REFERENCE",
      "type": "signal_coverage",
      "applies_to": "official_letter",
      "item_kind": "reference",
      "pattern": "(?:aktenzeichen|kassenzeichen|geschäftsnummer|steuernummer|kundennummer|az\\.)\\s*:?\\s*(?P<fact>[A-Z0-9][A-Z0-9 ./-]{3,})",
      "severity": "info",
      "message": "The letter contains a reference number ({fact}) that is not listed among the important details."
    },
    {
      "id": "C-MISSED-AMOUNT",
      "type": "signal_coverage",
      "applies_to": "official_letter",
      "item_kind": "payment",
      "pattern": "(?:gesamtbetrag|zu zahlender betrag|zahlbetrag|offener betrag|forderung|fällig(?:er betrag)?)\\s*:?\\s*(?:von\\s*)?(?P<fact>\\d{1,3}(?:\\.\\d{3})*,\\d{2}\\s?(?:eur|€))",
      "severity": "warning",
      "message": "The letter mentions an amount to pay ({fact}) that is not listed among the important details."
    },
    {
      "id": "C-MISSED-RELATIVE-DEADLINE",
      "type": "signal_coverage",
      "applies_to": "official_letter",
      "item_kind": "deadline",
      "pattern": "(?P<fact>innerhalb (?:von |eines |einer |eines )?(?:\\d+|zwei|drei|vier|fünf|sechs|sieben|zehn|vierzehn|einem|einer|eines) (?:stunden|tag(?:e|en)?|woche(?:n)?|monat(?:s|en)?))",
      "severity": "warning",
      "message": "The letter sets a time limit ({fact}) that is not listed among the important details."
    },
    {
      "id": "C-MISSED-IBAN",
      "type": "signal_coverage",
      "applies_to": "official_letter",
      "item_kind": "payment",
      "pattern": "iban\\s*:?\\s*(?P<fact>(?-i:[A-Z]{2}\\d{2}(?: ?[A-Z0-9]{1,4}){3,8}))",
      "severity": "warning",
      "message": "The letter contains a bank account ({fact}) that is not listed among the important details."
    },
    {
      "id": "C-MISSED-CONTACT",
      "type": "signal_coverage",
      "applies_to": "official_letter",
      "item_kind": "contact",
      "pattern": "(?:telefon|tel\\.)\\s*:?\\s*(?P<fact>\\+?[\\d][\\d /()-]{5,}\\d)",
      "severity": "info",
      "message": "The letter lists a phone number ({fact}) that is not shown among the important details."
    },
    {
      "id": "C-MISSED-CONSEQUENCE",
      "type": "signal_coverage",
      "applies_to": "official_letter",
      "item_kind": "consequence",
      "pattern": "(?P<fact>zwangsvollstreckung|vollstreckung|säumniszuschlag|mahngebühren?|erzwingungshaft|haftbefehl|pfändung|kündigung)",
      "severity": "warning",
      "message": "The letter mentions a consequence ({fact}) that is not listed among the important details."
    },
    {
      "id": "L-PERIOD-OWIG",
      "type": "expected_period",
      "applies_to": "bussgeldbescheid",
      "match_any": [
        "einspruch"
      ],
      "period_phrases": [
        "zwei wochen",
        "2 wochen",
        "14 tage",
        "vierzehn tage"
      ],
      "severity": "warning",
      "legal_basis": "owig_67",
      "message": "The objection period read from the letter differs from the legal standard of two weeks. Re-check the exact wording in the letter."
    },
    {
      "id": "L-PERIOD-AO",
      "type": "expected_period",
      "applies_to": "steuerbescheid",
      "match_any": [
        "einspruch"
      ],
      "period_phrases": [
        "einem monat",
        "einen monat",
        "1 monat",
        "eines monats"
      ],
      "severity": "warning",
      "legal_basis": "ao_355",
      "message": "The objection period read from the letter differs from the legal standard of one month. Re-check the exact wording in the letter."
    },
    {
      "id": "L-PERIOD-SGG",
      "type": "expected_period",
      "applies_to": "jobcenter_bescheid",
      "match_any": [
        "widerspruch"
      ],
      "period_phrases": [
        "einem monat",
        "einen monat",
        "1 monat",
        "eines monats"
      ],
      "severity": "warning",
      "legal_basis": "sgg_84",
      "message": "The objection period read from the letter differs from the legal standard of one month. Re-check the exact wording in the letter."
    },
    {
      "id": "L-PERIOD-MAHNBESCHEID",
      "type": "expected_period",
      "applies_to": "mahnbescheid",
      "match_any": [
        "widerspruch"
      ],
      "period_phrases": [
        "zwei wochen",
        "2 wochen",
        "14 tage",
        "vierzehn tage"
      ],
      "severity": "warning",
      "legal_basis": "zpo_692",
      "message": "The objection period read from the letter differs from the usual two weeks. Re-check the exact wording in the letter."
    },
    {
      "id": "S-UNUSUAL-PAYMENT-METHOD",
      "type": "text_pattern",
      "applies_to": "official_letter",
      "category": "scam",
      "pattern": "gutschein|guthabenkarte|paysafe|itunes|google[ -]?play|amazon[ -]?karte|bitcoin|krypto|kryptowährung|western union|moneygram|bargeld per post",
      "severity": "critical",
      "message": "The letter asks for payment by voucher, crypto currency or money transfer service. German authorities and legitimate companies never do this — this is very likely a scam. Do not pay."
    },
    {
      "id": "S-EXTREME-URGENCY",
      "type": "text_pattern",
      "applies_to": "official_letter",
      "category": "scam",
      "pattern": "innerhalb von (?:24|48|72) stunden|noch heute|sofortige zahlung|letzte (?:warnung|chance)|haftbefehl|verhaftung",
      "severity": "warning",
      "message": "The letter uses extreme time pressure or threats (e.g. arrest, 24-hour deadline). This is a common scam tactic; real authorities give reasonable deadlines."
    },
    {
      "id": "S-FOREIGN-IBAN-AUTHORITY",
      "type": "foreign_iban",
      "applies_to": "authority_letter",
      "category": "scam",
      "severity": "critical",
      "message": "A German authority asks for payment to a foreign bank account ({fact}). Authorities use German accounts — verify the letter with the authority (using contact details you look up yourself) before paying."
    },
    {
      "id": "S-IBAN-CHECKSUM",
      "type": "iban_checksum",
      "applies_to": "official_letter",
      "category": "scam",
      "severity": "warning",
      "message": "The bank account number {fact} is not a valid IBAN (checksum error). It may have been misread or the letter may be fake. Compare it digit by digit with the letter."
    },
    {
      "id": "E-HIGH-STAKES",
      "type": "escalate",
      "applies_to": "court_document",
      "reason": "Court documents have strict deadlines and legal consequences.",
      "resources": [
        "beratungshilfe",
        "verbraucherzentrale"
      ]
    },
    {
      "id": "E-IMMIGRATION",
      "type": "escalate",
      "applies_to": "auslaenderbehoerde",
      "reason": "Letters from the immigration office can affect your residence status.",
      "resources": [
        "mbeon",
        "beratungshilfe"
      ]
    },
    {
      "id": "E-TENANCY",
      "type": "escalate",
      "applies_to": "kuendigung_wohnung",
      "reason": "A termination of your tenancy has serious consequences and short deadlines.",
      "resources": [
        "mieterverein",
        "beratungshilfe"
      ]
    },
    {
      "id": "E-DEBT",
      "type": "escalate",
      "applies_to": "inkasso",
      "reason": "Debt collection claims are often inflated or unjustified. Check before you pay.",
      "resources": [
        "verbraucherzentrale",
        "schuldnerberatung"
      ]
    },
    {
      "id": "E-ENFORCEMENT-TEXT",
      "type": "escalate_on_pattern",
      "applies_to": "official_letter",
      "pattern": "zwangsvollstreckung|pfändung|gerichtsvollzieher|abschiebung|räumungsklage|erzwingungshaft",
      "reason": "The letter mentions enforcement or other serious legal consequences ({fact}).",
      "resources": [
        "beratungshilfe",
        "mbeon"
      ]
    }
  ]
}
