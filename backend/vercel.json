{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 120,
      "includeFiles": "app/**",
      "excludeFiles": "{tests/**,scripts/**,app/fixtures/sample_letter.png}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
